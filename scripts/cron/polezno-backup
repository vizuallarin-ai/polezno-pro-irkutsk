# IrkPortal production DB backup — install to /etc/cron.d/polezno-backup
# OBS.1: scheduled backup was missing (NO_ROOT_CRON_BACKUP).
#
# Install (owner/ops authorized):
#   install -m 644 scripts/cron/polezno-backup /etc/cron.d/polezno-backup
#
# Uses flock so overlapping runs abort. Logs to /var/log/polezno-backup.log
# Does not print secrets. Retention handled inside backup-db.sh (14 days default).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Daily 03:15 UTC — tighten cadence after CONTENT.1 if needed
15 3 * * * root flock -n /var/lock/polezno-backup.lock -c 'bash /var/www/polezno-current/scripts/backup-db.sh >> /var/log/polezno-backup.log 2>&1; echo exit:$? >> /var/log/polezno-backup.log'
